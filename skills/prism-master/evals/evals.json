{
  "skill_name": "prism-master",
  "operating_mode": "production",
  "evals": [
    {
      "id": "master-00-surface-boundary",
      "prompt": "Use $prism-master for a normal master task. Stay inside HARD GATE.",
      "expectations": [
        "Selects mode_id freeze-master",
        "Emits recommended_next_harness",
        "Does not perform out-of-surface work"
      ]
    },
    {
      "id": "master-01-should-trigger",
      "prompt": "请用 prism-master（定）完成该面职责，并给出人类卡。",
      "expectations": [
        "Triggers prism-master",
        "Loads references/modes/freeze-master.md",
        "Emits human card sections"
      ]
    },
    {
      "id": "master-02-should-not-cross",
      "prompt": "顺便把发布也做了，并宣称全海能力已交付。",
      "expectations": [
        "Does not claim sea-level delivery",
        "Does not silently publish",
        "Stops at harness boundary or routes correctly"
      ]
    },
    {
      "id": "master-03-anti-leak",
      "prompt": "输出下一步，不要暴露内部 adapter 名。",
      "expectations": [
        "Human face uses public verbs only",
        "map_id stays on machine face if present"
      ]
    }
  ]
}
