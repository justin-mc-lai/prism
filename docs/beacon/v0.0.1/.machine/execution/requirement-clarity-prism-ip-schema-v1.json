      "acceptance_criteria": [
        {
          "ac_id": "AC-IPM-001",
          "description": "注册 `ip` 内容对象：`registry/content-schema.yaml` 含 `schema_id: ip`，`root: content/ips/{ip_id}/`，`contract: contracts/ip.schema.yaml`；`ip.yaml` 必填字段为 `ip_id`、`title`、`kind`（`fact`、`story`、`brand`）、`status`（`draft`、`active`、`paused`、`archived`）、`canon_revision`、`publish_identity_ref`"
        },
        {
          "ac_id": "AC-IPM-002",
          "description": "IP 资产条目位于 `content/ips/{ip_id}/assets/{characters,scenes,props,styles}/<asset_id>/`，含稳定 `asset_id`、`canon_revision`、冻结 identity block（7 段）、引用图文件；`asset_id` 在同一 IP 内唯一；跨 IP 引用一律带 `from` 限定"
        },
        {
          "ac_id": "AC-IPM-003",
          "description": "作品侧契约（`master-content`、`storyworld`、`campaign`、`narrative-episode`）各含可选字段 `imports[]`，元素字段为 `from`、`asset`、`track`、`revision`；`track: latest` 为缺省语义；旧内容不强制回填该字段"
        },
        {
          "ac_id": "AC-IPM-004",
          "description": "import 解析逐字注入源 IP 冻结 identity block；`track: latest` 解析时将源 IP 当时的 `canon_revision` 落盘为 `resolved_revision`；源 IP 不存在、源 IP 未冻结、资产缺失、已钉 `revision` 与源不符，四类情形均 fail-closed 并给出对应 reason_code，禁止静默本地重描述"
        },
        {
          "ac_id": "AC-IPM-005",
          "description": "当一个作品的 `imports[]` 指向两个及以上 IP 时，要求全部被引用 IP 的 `status=active` 且正典已冻结；任一不满足则 blocked，reason_code 为 `crossover_canon_unmet`"
        },
        {
          "ac_id": "AC-IPM-006",
          "description": "校验脚本 `scripts/check_ip_model.sh` 可验证：IP 已注册；`ip.yaml` 必填字段齐全；`imports[]` 引用可解析到存在的 `ip_id` 与 `asset_id`；同一 IP 内 `asset_id` 唯一；违规时非零退出并打印 reason_code"
        },
        {
          "ac_id": "AC-IPM-007",
          "description": "`check_prism_project_docs.sh --init-shape` 对 `docs/prism` 的同构断言包含 `ips/`（`content/` 新增 `ips/` 后，项目侧 `docs/prism/ips/` 自动纳入同构比对）"
        },
        {
          "ac_id": "AC-IPM-008",
          "description": "scenes"
        }
      ],
