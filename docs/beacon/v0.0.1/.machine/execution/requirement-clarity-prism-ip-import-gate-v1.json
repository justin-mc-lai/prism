      "acceptance_criteria": [
        {
          "ac_id": "AC-IPG-001",
          "description": "新增 `crossovers` 内容对象：`registry/content-schema.yaml` 含 `schema_id: crossovers`，`root: content/crossovers/{crossover_id}.yaml`，契约 `contracts/crossover.schema.yaml`；必填 `crossover_id`、`participant_ips`（项数 ≥ 2）、`work_ref`、`authorization`、`attribution`"
        },
        {
          "ac_id": "AC-IPG-002",
          "description": "当作品 `imports[]` 涉及的 `from` 去重后项数 ≥ 2 时，必须存在 `content/crossovers/{crossover_id}.yaml` 且该项 `authorization.status=approved`；不满足即 blocked，reason_code 为 `crossover_authorization_missing`"
        },
        {
          "ac_id": "AC-IPG-003",
          "description": "联名记录须含非空 `disclosure_note`；缺失即 blocked，reason_code 为 `crossover_disclosure_missing`"
        },
        {
          "ac_id": "AC-IPG-004",
          "description": "联名记录声明分成时，`royalty_split` 各项占比合计等于 100%；当 `non_royalty` 显式声明为 true 时豁免该合计约束；两项均不满足即 blocked，reason_code 为 `crossover_royalty_unrecorded`"
        },
        {
          "ac_id": "AC-IPG-005",
          "description": "联名须逐个校验参与 IP 正典冻结状态：`participant_ips` 中任一项不满足 `status=active` 且正典冻结，即 blocked，reason_code 为 `crossover_canon_unmet`（复用 L1 判定口径）"
        },
        {
          "ac_id": "AC-IPG-006",
          "description": "确定性校验脚本 `scripts/check_ip_import_gate.sh` 对给定作品与联名记录判定合规；违规时非零退出并打印对应 reason_code；须支持 `--self-test` 与 `--invert`"
        },
        {
          "ac_id": "AC-IPG-007",
          "description": "与 F1/F2 叠加：联名涉变现时，`contracts/monetization.contract.md` 披露门同时适用；涉改编时，`contracts/adaptation.contract.md` 授权门同时适用；两门均记录 hook 引用且不互相替代"
        }
      ],
