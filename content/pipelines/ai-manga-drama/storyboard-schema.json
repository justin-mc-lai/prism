{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-manga-drama-storyboard",
  "description": "Episode storyboard. 资产三层：characters(人物) / scenes(场景: interior|exterior) / props(道具)。scenes 与 props 为可选，兼容仅含 characters 的历史实例。",
  "type": "object",
  "required": ["episode", "title", "ratio", "duration_seconds", "mode", "characters", "shots"],
  "properties": {
    "episode": { "type": "string", "pattern": "^ep-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "ratio": { "enum": ["9:16"] },
    "duration_seconds": { "type": "integer", "minimum": 60, "maximum": 90 },
    "mode": { "enum": ["production", "template"] },
    "provider": { "type": "string", "description": "目标 provider（prism-shot-iteration-budget-v1 能力域门必填）。" },
    "model": { "type": "string", "description": "目标模型；动作/对白须落在 reachable 白名单内。" },
    "reachable": {
      "type": "object",
      "description": "能力域可达白名单（AC-ITB-005）。",
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" } },
        "dialogue": { "type": "array", "items": { "type": "string" } }
      }
    },
    "threshold_source": {
      "type": "object",
      "description": "阈值来源义务（AC-ITB-007）：预算/降级上限/可达白名单的来源与测试条件（题材 + 模型）。",
      "properties": {
        "iteration_budget": { "type": "string" },
        "max_downgrades": { "type": "string" },
        "reachable": { "type": "string" }
      }
    },
    "spec": {
      "type": "string",
      "enum": ["manju-drama"],
      "description": "分镜填写规范标识。manju-drama = 神魔修仙漫剧规范（MJ-*）：shots[].beats[] 强制过 contracts/drama-storyboard-spec.contract.md，编译器额外产出 分镜脚本.md。"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "description": "人物。身份锚点写进 traits；voice_id 供 TTS 选用（缺省走 provider 默认音色）。",
      "items": {
        "type": "object",
        "required": ["id", "name", "traits"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "traits": { "type": "string" },
          "voice": { "type": "string" },
          "voice_id": { "type": "string" },
          "ref_image": {
            "type": "string",
            "description": "身份参考图路径（相对 episode 目录）。声明即须解析到真实文件；T2I 产物回填处，编译资产/图片提示词时作为视觉锚点。"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "场景（内景/外景）。kind 区分 interior|exterior；时间/天气作为场景变体写在 variant。",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "traits"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "kind": { "enum": ["interior", "exterior"] },
          "traits": { "type": "string" },
          "variant": { "type": "string" },
          "ref_image": { "type": "string", "description": "场景定调图路径（相对 episode 目录）；声明即须解析到真实文件。" }
        }
      }
    },
    "props": {
      "type": "array",
      "description": "道具。holder 填 characters[].id，标明当前持有者（换手即换 holder，不新建身份）。",
      "items": {
        "type": "object",
        "required": ["id", "name", "traits"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "traits": { "type": "string" },
          "holder": { "type": "string" },
          "ref_image": { "type": "string", "description": "道具参考图路径（相对 episode 目录）；声明即须解析到真实文件。" }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "description", "dialogue", "asset_ref", "duration_seconds"],
        "properties": {
          "shot_id": { "type": "string" },
          "description": { "type": "string", "minLength": 10 },
          "dialogue": { "type": "string" },
          "asset_ref": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 1 },
          "iteration_budget": { "type": "integer", "minimum": 1, "description": "本镜生成尝试上限（AC-ITB-001）。" },
          "attempts": { "type": "integer", "minimum": 0, "description": "本镜实际生成尝试次数（AC-ITB-001）。" },
          "convergence": { "enum": ["native", "simplified", "redesigned"], "description": "收敛方式；超预算时不得为 native（AC-ITB-002）。" },
          "max_downgrades": { "type": "integer", "minimum": 0, "description": "降级次数上限，超过即 shot_aborted（AC-ITB-002）。" },
          "downgrades": { "type": "integer", "minimum": 0, "description": "实际降级次数（AC-ITB-002）。" },
          "dialogue_source": { "enum": ["native", "redesigned_none", "post_dub"], "description": "对白来源；post_dub 违规 fail-closed（AC-ITB-003）。" },
          "ref_image": {
            "type": "string",
            "description": "本镜参考图路径（相对 episode 目录）。缺省回落 asset_ref；声明即须解析到真实文件。"
          },
          "scene_ref": { "type": "string", "description": "必须解析到 scenes[].id" },
          "cast": {
            "type": "array",
            "items": { "type": "string" },
            "description": "本分镜实际出现的角色 id 列表（MJ-TPL-03 人物栏，仅写名称）。必须逐个解析到 characters[].id。"
          },
          "prop_refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "必须逐个解析到 props[].id"
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "description": "子镜（MJ-UNIT/字段定式）。spec=manju-drama 时必填 5-8 个，每个 2-5s，Σ = duration_seconds；规则见 contracts/drama-storyboard-spec.contract.md。",
            "items": {
              "type": "object",
              "required": ["beat_id", "duration_seconds", "shot_size", "camera_move", "vfx", "sfx", "dialogue", "emotion", "speech_rate", "on_screen", "blocking", "description"],
              "properties": {
                "beat_id": { "type": "string" },
                "duration_seconds": { "type": "number", "minimum": 1, "maximum": 6 },
                "shot_size": { "enum": ["极远景", "远景", "全景", "中景", "近景", "特写", "大特写"] },
                "camera_move": { "type": "string" },
                "vfx": { "type": "string", "minLength": 1 },
                "sfx": { "type": "string", "minLength": 1, "maxLength": 10, "description": "音效，≤10 字，禁写「无」" },
                "dialogue": { "type": "string" },
                "emotion": { "enum": ["愤怒", "冷漠", "平静", "蔑视", "威严", "恐惧", "内心独白", "坚定"] },
                "speech_rate": { "enum": ["正常", "激动", "快", "低沉", "慢", "内心独白"] },
                "on_screen": { "type": "integer", "minimum": 1, "description": "画面内人数（MJ-BLOCK-01）" },
                "blocking": { "type": "string", "minLength": 1, "description": "站位/方位锁定语句（MJ-BLOCK-02..09）" },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
